{
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true,
    "impeccable@impeccable": true,
    "task-observer@one-skill-to-rule-them-all": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "one-skill-to-rule-them-all": {
      "source": {
        "source": "github",
        "repo": "rebelytics/one-skill-to-rule-them-all"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-observer-session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
